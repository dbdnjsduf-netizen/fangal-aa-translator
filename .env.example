# 권장 구성: Ollama 앱에서 `ollama signin` 후 로컬 API를 통해 Cloud 모델 사용
# 이 방식은 로그인한 Ollama Pro 계정의 구독 할당량을 자동으로 사용합니다.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
# UI에서 로컬 번역 모델을 선택하려면: ollama pull translategemma:4b

# 직접 Ollama Cloud API를 호출할 때만 아래 키를 설정하세요.
# 이 경우 OLLAMA_HOST=https://ollama.com, OLLAMA_MODEL=gemma4:31b를 사용합니다.
# OLLAMA_API_KEY=replace_with_your_own_key
#
# Gemini/OpenRouter 키는 .env에 넣지 않습니다. 앱의 [번역 엔진] 창에서 사용자가 직접
# 입력하며 현재 브라우저 탭의 sessionStorage에만 보관됩니다.

# 생성/서버 튜닝
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_MS=300000
OLLAMA_MAX_CONCURRENCY=3

# Codex ChatGPT OAuth 모드. 먼저 터미널에서 `codex login`을 실행하세요.
# 앱은 Codex 인증 파일을 읽지 않고 설치된 CLI에 실행을 위임합니다.
CODEX_REQUEST_TIMEOUT_MS=330000
CODEX_MAX_CONCURRENCY=2
# Codex CLI가 자동 감지되지 않을 때만 실행 파일 또는 codex.js 절대 경로를 지정합니다.
# CODEX_CLI_PATH=C:\\Users\\your-name\\AppData\\Roaming\\npm\\node_modules\\@openai\\codex\\bin\\codex.js

# OpenRouter 요청은 입력한 개인 키를 사용해 로컬 서버가 중계합니다.
OPENROUTER_REQUEST_TIMEOUT_MS=300000
OPENROUTER_MAX_CONCURRENCY=3

# 웹 서버. 외부 공개가 필요하지 않으면 기본 루프백 주소를 유지하세요.
APP_HOST=127.0.0.1
PORT=3000
# 로컬 주소에서는 마지막 번역기 탭을 닫으면 서버도 자동 종료됩니다.
# APP_AUTO_SHUTDOWN=1
APP_SHUTDOWN_DELAY_MS=4000
